<%- include('partials/header.ejs'); -%>


<div class="box" id="heading">
  <h1> <%= listTitle %> </h1>
</div>

<% if (currentUserId) { %>


<form action="/date-type" method="post" class="item  choose-date-type">
  <div>
    <input id="daily" type="radio" name="dateType" value="daily" onchange="this.form.submit()" <%= listType === 'daily' ? 'checked' : '' %> />
    <label for="daily">Daily</label>
  </div>
  <div>
    <input id="weekly" type="radio" name="dateType" value="weekly" onchange="this.form.submit()" <%= listType === 'weekly' ? 'checked' : '' %> />
    <label for="weekly">Weekly</label>
  </div>
  <div>
    <input id="monthly" type="radio" name="dateType" value="monthly" onchange="this.form.submit()" <%= listType === 'monthly' ? 'checked' : '' %> />
    <label for="monthly">Monthly</label>
  </div>
</form>

<div class="box">
  <% for(let item of listItems){%>
  <div class="item">
    <form action="/delete" method="post">
      <input class="delete-checkbox" type="checkbox" onchange="this.form.submit()" name="deleteItemId" value="<%= item.id %>">
    </form>

    <p id="title<%=item.id%>">
      <%= item.title %>
    </p>

    <form id="edit-form<%=item.id%>" class="edit" action="/edit" method="post">
      <input type="hidden" name="updatedItemId" value="<%= item.id %>">
      <input id="input<%=item.id%>" type="text" name="updatedItemTitle" value="<%= item.title %>" autocomplete="off" autofocus="true" hidden="true" />
      <button id="done<%=item.id%>" class="edit" type="submit" hidden><img class="icon" src="/assets/icons/check-solid.svg" alt="tick image"></button>
    </form>
    <button id="edit<%=item.id%>" class="edit edit-button" type="button" onclick="handler('<%=item.id%>')"><img class="icon" src="/assets/icons/pencil-solid.svg" alt="pencil image"></button>
  </div>
  <% } %>

  <form class="" action="/add" method="post">
    <div class="item add-container">
      <input type="hidden" name="userId" value="<%= currentUserId %>">
      <input type="text" name="newItem" placeholder="<%= error ? error : 'New Item' %>" autocomplete="off" autofocus="true" required />
      <button id="add-new-item" class="add" type="submit" name="list" value=<%=listTitle %>>+</button>
    </div>
  </form>
</div>

<% } %>

<div class="add-new-user-container"><a href="/new">Add New User</a></div>

<form class="tab-view tab-view-height-auto" action="/user" method="post">
  <% users.forEach(function(user) { %>

  <div class="user-form-container" <% if (currentUserId === user.id) { %> style="transform: scale(1.1); z-index: 1;" <% } %>>
    <div class="user-container">
      <input type="submit" name="user" value="<%= user.id %>" id="<%= user.id %>">
      <label for="<%= user.id %>">
        <%= user.name %>
      </label>
    </div>

    <div class="delete-user-container">
      <input type="submit" name="deleteUser" value="<%= user.id %>" id="delete-<%= user.id %>">
      <label for="delete-<%= user.id %>">
        <i class="bi bi-x"></i>
      </label>
    </div>
  </div>


  <% }); %>
</form>

<script>
  function handler(id) {
    document.querySelectorAll(".edit-button").forEach(button => {
      if (button.id !== "edit" + id) {
        button.disabled = true;
      }
    });

    document.querySelectorAll(".delete-checkbox").forEach(checkbox => {
      checkbox.disabled = true;
    });

    document.getElementById("add-new-item").disabled = true;

    document.getElementById("title" + id).setAttribute("hidden", true)
    document.getElementById("edit" + id).setAttribute("hidden", true)
    document.getElementById("done" + id).removeAttribute("hidden")
    document.getElementById("input" + id).removeAttribute("hidden")

    document.querySelectorAll('[id^="edit-form"]').forEach(form => {
      // .toggle(class, condition) adds class if true, removes if false
      form.classList.toggle("large", form.id === `edit-form${id}`);
    });
  }
</script>
<%- include('partials/footer.ejs'); -%>